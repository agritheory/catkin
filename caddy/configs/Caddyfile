# 	}
# }

# Development configuration for simplified testing (localhost:8001)
http://localhost:8001 {
	# Health check (no auth required)
	handle /health {
		respond "OK" 200
	}

	# Authentication service
	handle /auth/* {
		reverse_proxy localhost:5000
	}

	# Protected service
	handle /app/* {
		forward_auth localhost:5000 {
			uri /auth/verify
			copy_headers X-User-Email X-User-ID X-Auth-Method
			header_up X-Forwarded-Uri {uri}
		}

		# Remove /app prefix before forwarding
		uri strip_prefix /app
		reverse_proxy localhost:8080
	}

	# Root redirect
	handle / {
		redir /auth/login 302
	}

	# Catch-all redirect
	handle {
		redir /auth/login?redirect={uri} 302
	}
}
