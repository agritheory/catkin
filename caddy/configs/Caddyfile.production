# Production Caddyfile with HTTPS and enhanced security
# Replace your-domain.com with your actual domain

{
    # Global options
    auto_https on
    email your-email@domain.com
}

# Main authentication and application domain
your-domain.com {
    # Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy (adjust as needed)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }

    # Enhanced logging for production
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }

    # Authentication service routes
    handle /auth/* {
        reverse_proxy auth:5000 {
            # Health check
            health_uri /health
            health_interval 30s
            health_timeout 5s

            # Load balancing (if multiple auth instances)
            lb_policy round_robin

            # Headers
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Protected application 1
    handle /app1/* {
        forward_auth auth:5000 {
            uri /auth/verify
            copy_headers X-User-Email X-User-ID X-Auth-Method

            # Custom headers for this specific app
            header_up X-App-Name "app1"
        }

        reverse_proxy app1:80 {
            # Strip /app1 prefix
            uri strip_prefix /app1

            # Health check
            health_uri /health
            health_interval 30s
            health_timeout 5s

            # Headers
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Protected admin panel
    handle /admin/* {
        forward_auth auth:5000 {
            uri /auth/verify
            copy_headers X-User-Email X-User-ID X-Auth-Method

            # Additional security: could add role-based checks here
            header_up X-Required-Role "admin"
        }

        reverse_proxy app2:80 {
            uri strip_prefix /admin

            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API endpoints with different auth strategy
    handle /api/* {
        forward_auth auth:5000 {
            uri /auth/verify
            copy_headers X-User-Email X-User-ID X-Auth-Method
        }

        reverse_proxy api-service:8080 {
            uri strip_prefix /api

            # API-specific headers
            header_up X-API-Version "v1"
            header_up Content-Type "application/json"
        }
    }

    # Public static content (no auth required)
    handle /public/* {
        root * /var/www/public
        file_server

        # Cache static assets
        header {
            Cache-Control "public, max-age=3600"
        }
    }

    # Health check endpoint (public)
    handle /health {
        respond "OK" 200
    }

    # Default route - redirect to login
    handle {
        redir /auth/login?redirect={uri} 302
    }

    # Enhanced error handling
    handle_errors {
        @auth_required expression {http.error.status_code} == 401
        @forbidden expression {http.error.status_code} == 403
        @not_found expression {http.error.status_code} == 404
        @server_error expression {http.error.status_code} >= 500

        # Authentication required
        redir @auth_required /auth/login?redirect={uri} 302

        # Forbidden - user authenticated but not authorized
        respond @forbidden "Access Denied" 403

        # Not found
        respond @not_found "Page Not Found" 404

        # Server errors
        respond @server_error "Internal Server Error" 500
    }
}

# API-only subdomain (for mobile apps, etc.)
api.your-domain.com {
    # CORS headers for API
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key"
        Access-Control-Max-Age "86400"
    }

    # Handle preflight requests
    @cors_preflight method OPTIONS
    respond @cors_preflight 204

    # API authentication (supports both JWT cookies and API keys)
    forward_auth auth:5000 {
        uri /auth/verify
        copy_headers X-User-Email X-User-ID X-Auth-Method X-API-Key-ID
    }

    reverse_proxy api-service:8080 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    handle_errors {
        @auth_required expression {http.error.status_code} == 401
        respond @auth_required `{"error": "Authentication required", "code": 401}` 401 {
            header Content-Type application/json
        }
    }
}

# Monitoring subdomain (admin access only)
monitoring.your-domain.com {
    # Extra security for monitoring
    forward_auth auth:5000 {
        uri /auth/verify
        copy_headers X-User-Email X-User-ID X-Auth-Method

        # Could be enhanced to check for admin role
        header_up X-Required-Role "admin"
    }

    reverse_proxy monitoring-service:3000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
