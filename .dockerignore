# Docker ignore file for catkin project

# Version control
.git
.gitignore
.github

# Python cache files
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
.Python
.pytest_cache
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
venv
env
ENV
.venv
.env
.env.*
!.env.docker.example

# Docker related
.dockerignore
docker-compose*.yml
Dockerfile*

# Development/IDE files
.idea
.vscode
*.swp
*.swo
*~

# Documentation
README.md
LICENSE
DOCKER.md
docs/
caddy/docs/

# Build artifacts
build/
dist/
*.egg-info/

# Test data
tests/
test/

# Logs
logs/
**/*.log

# Local data
data/
caddy/container/

# Don't include demo applications - they should be mounted externally if needed
caddy/demo-apps/
